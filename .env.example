SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
# Sem DATABASE_URL usa sqlite. O compose injecta o URL do MySQL para o container;
# para o runserver local usar a MESMA BD do compose, descomente:
# DATABASE_URL=mysql://mozcyber:mozcyber@127.0.0.1:3307/mozcyber
DB_NAME=mozcyber
DB_USER=mozcyber
DB_PASSWORD=mozcyber
DB_ROOT_PASSWORD=root
DB_PORT=3307
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
WEB_PORT=8000
# true instala dependências de dev (ipython, pytest) na imagem; usar false em produção
INSTALL_DEV=true
